# Required for agent.py (the LLM that chooses which tool to call)
OPENAI_API_KEY=

# Optional. Model used by the agent; defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Optional. Sampling temperature; defaults to 0. Set to "none" to omit the
# field entirely (some reasoning models reject it).
OPENAI_TEMPERATURE=0

# Optional. Max LLM turns before the agent gives up; defaults to 5.
AGENT_MAX_TURNS=5

# Optional. Raises the GitHub API rate limit for search_github_repos.
GITHUB_TOKEN=
